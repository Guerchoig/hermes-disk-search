# Окружение и кэши
.venv/
__pycache__/
*.py[cod]
*.log
watch.lock

# Runtime-сигналы индексатора (кросс-процессный статус и файлы-команды)
index.heartbeat.json
index.stop
index.pause

# Локальные данные (индекс не входит в репозиторий)
index.db
index.db-shm
index.db-wal
index.db*.moved-*
index.db.moved*
test_data/
models/
# W6: веса моделей (Nemotron-3 .onnx, sortformer .gguf) в репозиторий не входят и в
# релизный архив не кладутся — их ставит установщик
# (installers\fetch_nemotron3_model.ps1, fetch_diarization_model.ps1).
*.onnx
*.onnx.data
*.onnx.part
*.gguf

# llama.cpp: бинарь и runtime llama-server (~0,6-1 ГБ) + PID-файлы/логи менеджера
tools/llama.cpp/
# M2 T0: `data/` целиком исключал каталог, и ре-инклуд `!data/access.example.yaml`
# не работал (git не заходит внутрь исключённого каталога) — файл не был в репо.
data/*
# M1: образец хранилища доступа — в репозитории (сам data/access.yaml игнорируется)
!data/access.example.yaml

# Среда
.env
.idea/
.vscode/

# Rust (воркспейс `crates/`, спайки W0 `tools/parity/spikes`)
target/
# W4: релизная сборка (installers/build_rust_release.ps1)
dist/
# W4: собранный самодостаточный sidecar (installers/build_sidecar.ps1):
# портативный CPython + зависимости + копия модулей извлечения
sidecar/python/
sidecar/hds/
# P5: profile venvs of the transcription sidecar (built by
# installers\build_transcribe_sidecar.ps1, 1.5-6 GB)
sidecar/venv-transcribe/
sidecar/venv-transcribe-dml/
# Eval-набор качества поиска (персональные пути/содержимое — в репозиторий не коммитится)
eval/

# Личная конфигурация (пути дисков пользователя); образец — config.example.yaml,
# при первом запуске config.yaml создаётся автоматически
config.yaml
# ��������� ��������� ������ ����������
out/
transcribe.lock

# Секреты и токены доступа (plain-токены; см. data/access.yaml) — не коммитим
tokens.txt
token.txt
